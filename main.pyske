class Пристрій:
    def __init__(self, назва):
        self.назва = назва

    def увімкнути(self):
        print(f"{self.назва} увімкнено.")

    def вимкнути(self):
        print(f"{self.назва} вимкнено.")


class Телефон(Пристрій):
    def __init__(self, назва, модель):
        super().__init__(назва)
        self.модель = модель

    def подзвонити(self):
        print(f"{self.назва} ({self.модель}) здійснює дзвінок.")


class Ноутбук(Пристрій):
    def __init__(self, назва, ос):
        super().__init__(назва)
        self.ос = ос

    def запустити_програму(self):
        print(f"{self.назва} на базі {self.ос} запускає програму.")


телефон = Телефон("Смартфон", "iPhone 15")
ноутбук = Ноутбук("Ноутбук", "Windows 11")

телефон.увімкнути()
телефон.подзвонити()
телефон.вимкнути()

ноутбук.увімкнути()
ноутбук.запустити_програму()
ноутбук.вимкнути()
