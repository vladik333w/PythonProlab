class Водій:
    def __init__(self, імя, енергія=100):
        self.імя = імя
        self.енергія = енергія
        self.авто = None

    def купити_авто(self, авто):
        self.авто = авто
        print(f"{self.імя} купив авто: {self.авто.марка}.")

    def їхати(self, відстань):
        if self.авто is None:
            print(f"{self.імя} не має авто.")
        elif self.енергія < 20:
            print(f"{self.імя} занадто втомлений для поїздки.")
        else:
            if self.авто.їхати(відстань):
                self.енергія -= 20
                print(f"{self.імя} проїхав {відстань} км. Залишилось енергії: {self.енергія}.")

    def відпочити(self):
        self.енергія = 100
        print(f"{self.імя} відпочив. Енергія відновлена до {self.енергія}.")

class Авто:
    def __init__(self, марка, пальне=50):
        self.марка = марка
        self.пальне = пальне

    def їхати(self, відстань):
        витрати = відстань * 0.1
        if self.пальне >= витрати:
            self.пальне -= витрати
            print(f"Авто {self.марка} витратило {витрати} л пального. Залишок: {self.пальне} л.")
            return True
        else:
            print(f"У {self.марка} недостатньо пального для поїздки на {відстань} км.")
            return False

    def заправити(self, літри):
        self.пальне += літри
        print(f"Авто {self.марка} заправлено на {літри} л. Тепер пального: {self.пальне} л.")

водій = Водій("Максим")
машина = Авто("BMW")

водій.купити_авто(машина)
водій.їхати(100)
водій.їхати(150)
машина.заправити(30)
водій.відпочити()
водій.їхати(150)
